{
  "name": "poser",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "pnpm --filter @poser/web dev",
    "build": "pnpm --filter @poser/web build",
    "preview": "pnpm --filter @poser/web preview",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "test:gpu": "POSER_GPU_TESTS=1 vitest run",
    "serve": "node tools/pagesserve.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@webgpu/types": "^0.1.60",
    "fake-indexeddb": "^6.2.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "~5.9.3",
    "vite": "^8.0.5",
    "vitest": "^4.0.5",
    "webgpu": "^0.6.2"
  }
}
